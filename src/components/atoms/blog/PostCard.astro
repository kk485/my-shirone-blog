---
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
/**
 * M3E 博客原子 — PostCard 文章卡片。
 * 数据驱动：标题 / 描述 / 封面 / 元信息（复用 blog/PostMeta）/ 阅读时长。
 * 视觉对齐 display/Card 令牌：surface-container-high 基、corner-large、
 * hover 抬升阴影 + 标题 primary + 箭头滑出；有封面时桌面端右侧 28% 图。
 */
import { Icon } from "astro-icon/components";
import type { BlogMetaLink } from "./PostMeta.astro";
import PostMeta from "./PostMeta.astro";

interface Props {
	href: string;
	title: string;
	description?: string;
	/** 封面图地址（省略则无封面，右侧显示进入箭头按钮） */
	image?: string;
	imageSrcset?: string;
	imageAvifSrcset?: string;
	imageSizes?: string;
	imageWidth?: number;
	imageHeight?: number;
	imageAlt?: string;
	published?: string;
	updated?: string;
	pinned?: boolean;
	encrypted?: boolean;
	category?: BlogMetaLink | null;
	tags?: BlogMetaLink[];
	/** 字数展示文本（如 "1426 words"，渲染在分类右侧） */
	wordCount?: string;
	class?: string;
	style?: string;
}

const {
	href,
	title,
	description,
	image,
	imageSrcset,
	imageAvifSrcset,
	imageSizes,
	imageWidth,
	imageHeight,
	imageAlt = "",
	published,
	updated,
	pinned = false,
	encrypted = false,
	category = null,
	tags = [],
	wordCount,
	class: className,
	style,
} = Astro.props;

const hasCover = !!image;
const pinnedLabel = i18n(I18nKey.pinned);
const encryptedLabel = i18n(I18nKey.postEncryptedBadge);
/* 置顶 + 加密并存时合入可访问名称，避免屏幕阅读器丢失任一状态 */
const stateLabels = [
	pinned ? pinnedLabel : "",
	encrypted ? encryptedLabel : "",
].filter(Boolean);
const titleLabel =
	stateLabels.length > 0 ? `${title}, ${stateLabels.join(", ")}` : title;

// 👇 新增：计算阅读时间
const readingMinutes = wordCount
	? Math.max(1, Math.round(parseInt(wordCount.replace(/\D/g, ""), 10) / 300))
	: null;
---

<article
	class:list={["m3-blog-postcard", { "m3-blog-postcard--cover": hasCover }, className]}
	style={style}
>
	<div class="m3-blog-postcard__body">
		<a
			class="m3-blog-postcard__title"
			href={href}
			aria-label={titleLabel}
		>
			<AccentBar size="medium" />
			{encrypted && !pinned && (
				<span class="m3-blog-postcard__encrypted" aria-hidden="true" title={encryptedLabel}>
					<Icon name="material-symbols:lock-rounded" />
				</span>
			)}
			<span class="m3-blog-postcard__title-text">{title}</span> {/* 👈 核心：加上这个 span */}
			<Icon class="m3-blog-postcard__arrow" name="material-symbols:chevron-right-rounded" />
		</a>
		{(published || pinned) && (
			<div class="m3-blog-postcard__meta-row">
				{pinned && (
					<span
						class:list={[
							"m3-blog-postcard__pin",
							{ "m3-blog-postcard__pin--locked": encrypted },
						]}
						
						title={encrypted ? `${pinnedLabel}, ${encryptedLabel}` : pinnedLabel}
					>
						<Icon name="material-symbols:keep-rounded" />
						<span class="m3-blog-postcard__pin-text">{pinnedLabel}</span>
						{encrypted && (
							<span class="m3-blog-postcard__pin-lock">
								<Icon name="material-symbols:lock-rounded" />
							</span>
						)}
					</span>
				)}
				{published && (
					<PostMeta
						class="m3-blog-postcard__meta"
						{published}
						category={category}
						tags={tags}
						hideDate
						hideWordCount
						hideUpdate
					/>
				)}
			</div>
		)}
		{description && <p class="m3-blog-postcard__desc">{description}</p>}
		{published && (
			<div class="m3-blog-postcard__footer">
				{/* 日期 */}
				<span class="m3-blog-postcard__footer-item">
					<Icon name="material-symbols:calendar-today-outline-rounded" />
					{published}
				</span>

				{/* 字数 */}
				{wordCount && (
					<>
						<span class="m3-blog-postcard__footer-divider">|</span>
						<span class="m3-blog-postcard__footer-item">
							<Icon name="material-symbols:article-outline-rounded" is:inline />
							{wordCount}
						</span>
					</>
				)}

				{/* 阅读时间 */}
				{readingMinutes && (
					<>
						<span class="m3-blog-postcard__footer-divider">|</span>
						<span class="m3-blog-postcard__footer-item">
							<Icon name="material-symbols:schedule-outline-rounded" />
							{readingMinutes} 分钟
						</span>
					</>
				)}
			</div>
		)}
	</div>
	<div class="m3-blog-postcard__cover">
		{hasCover ? (
			<>
				<span class="m3-blog-postcard__cover-loading" aria-hidden="true"></span>
				<picture>
					{imageAvifSrcset && <source type="image/avif" srcset={imageAvifSrcset} sizes={imageSizes} />}
					<img
						src={image}
						srcset={imageSrcset}
						sizes={imageSizes}
						width={imageWidth}
						height={imageHeight}
						alt={imageAlt}
						loading="lazy"
						decoding="async"
						onload="this.parentElement?.previousElementSibling?.classList.add('m3-blog-postcard__cover-loading--done')"
						onerror="this.parentElement?.previousElementSibling?.classList.add('m3-blog-postcard__cover-loading--done')"
					/>
				</picture>
			</>
		) : (
			<div class="m3-blog-postcard__cover-placeholder" aria-hidden="true"></div>
		)}
	</div>
</article>

<style lang="stylus">
@import "../../../styles/breakpoints.styl"
.m3-blog-postcard
	position: relative
	display: flex
	/* 移动端封面置顶（DOM：body → cover，column-reverse 反转为 cover 在前） */
	flex-direction: column-reverse
	box-sizing: border-box
	width: 100%
	overflow: hidden
	border-radius: var(--shape-corner-l)
	/* 站点卡片色（浅色 = surface-container-lowest 近白），与侧栏等其它卡片一致 */
	background: var(--card-bg)
	color: var(--on-surface)

	&__body
		flex: 1
		min-width: 0
		padding: 1.5rem 1.5rem 1.25rem
		display: flex               /* 👈 新增 */
		flex-direction: column       /* 👈 新增 */

	&__title
		display: flex
		align-items: flex-start           /* 👈 改为 flex-start，让箭头对齐第一行顶部 */
		gap: 0.5rem
		margin: 0
		font-size: 1rem
		font-weight: 600
		color: var(--on-surface)
		text-decoration: none
		border-radius: var(--shape-corner-xs)
		transition: color var(--m3e-duration-short) var(--m3e-easing-standard)
		&:focus-visible
			outline: 2px solid var(--primary)
			outline-offset: 2px
		.m3-blog-postcard:hover &
			color: var(--primary)
			
		/* 👇 新增：微调小竖线的位置和间距 */
		> :global(.m3-accent-bar)
			margin-right: 0.1rem         /* 👈 删掉 -0.25rem，改成 0.1rem 或者直接删掉这一行 */
			margin-top: 0.1em              /* 稍微往下移一点点，和文字中线对齐 */

	/* 👇 新增：专门针对文字进行 2 行截断 */
	&__title-text
		display: -webkit-box
		-webkit-line-clamp: 2
		-webkit-box-orient: vertical
		overflow: hidden
		word-break: break-all
		line-height: 1.35

	&__arrow
		flex-shrink: 0
		width: 1.5rem
		height: 1.5rem
		color: var(--primary)
		transition: transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate)
		.m3-blog-postcard:hover &
			transform: translateX(0.25rem)

	/* 分类+标签行：强制最多两行截断 */
	&__meta-row
		display: -webkit-box
		-webkit-line-clamp: 2
		-webkit-box-orient: vertical
		overflow: hidden
		word-break: break-all
		margin-top: var(--m3e-space-2)
		line-height: 1.6

	/* 打碎 PostMeta 容器，让内部元素参与文本流 */
	&__meta-row :global(.m3-blog-postmeta)
		display: contents

	/* 分类和标签项参与文本流 */
	&__meta-row :global(.m3-blog-postmeta__item)
		display: inline
		
	/* 标签内部也变成 inline 纯文本 */
	&__meta-row :global(.m3-blog-postmeta__tags)
		display: inline

	/* 👇 卡片专属：去掉图标底色，缩小尺寸 */
	&__meta-row :global(.m3-meta-icon)
		display: inline-flex
		align-items: center
		justify-content: center
		width: 0.95em
		height: 0.95em
		border-radius: 0
		background: transparent
		color: inherit
		line-height: 1
		vertical-align: middle
		transform: translateY(1px)
		margin-right: 0.2rem
		> :global(svg)
			width: 100%
			height: 100%

	/* 👇 卡片专属：缩小链接和文字的字号 */
	&__meta-row :global(.m3-blog-postmeta__link),
	&__meta-row :global(.m3-blog-postmeta__text)
		font-size: 0.8rem

	&__pin
		display: inline-flex
		align-items: center
		gap: 0.2rem
		padding: 0.15rem 0.5rem
		border-radius: 9999px
		background: var(--primary-container)
		color: var(--on-primary-container)
		font-size: 0.8rem
		font-weight: 500
		line-height: 1
		white-space: nowrap
		vertical-align: middle      /* 抛弃 translateY，回归最稳的 middle */
		transform: translateY(-1px)     /* 👈 胶囊轻微上提 1px */
		margin-right: 0.4rem
		> :global(svg)
			width: 1em
			height: 1em

	&__pin-text
		line-height: 1

	&__encrypted
		display: inline-flex
		align-items: center
		justify-content: center
		flex: 0 0 1.75rem
		height: 1.75rem
		border-radius: var(--shape-corner-m)
		background: var(--tertiary-container)
		color: var(--on-tertiary-container)
		> :global(svg)
			width: 1.125rem
			height: 1.125rem

	/* 置顶 + 加密角标：tertiary 小锁圆点叠加在 pin 徽标右上角（BadgedBox 语言），
	   带卡片色描边与背景分离，整体宽度与单 pin 徽标一致 */
	&__pin-lock
		position: absolute
		top: -0.375rem
		right: -0.375rem
		display: inline-flex
		align-items: center
		justify-content: center
		width: 1rem
		height: 1rem
		border-radius: var(--shape-corner-full)
		background: var(--tertiary-container)
		color: var(--on-tertiary-container)
		box-shadow: 0 0 0 2px var(--card-bg)
		> :global(svg)
			width: 0.625rem
			height: 0.625rem

	&__desc
		margin: var(--m3e-space-2) 0 0
		font: var(--m3e-type-body-medium)
		color: var(--on-surface-variant)
		line-height: 1.6
		min-height: 3.2em            /* 👈 新增：1.6 * 2行 = 3.2em，强制撑开 */
		display: -webkit-box
		-webkit-line-clamp: 2
		-webkit-box-orient: vertical
		overflow: hidden

	/* 👇👇👇 底部信息行：纯手写，完美对齐 👇👇👇 */
	&__footer
		display: flex
		align-items: center
		flex-wrap: nowrap
		gap: 0.45rem
		margin-top: auto             /* 👈 核心修改：把原来的 var(--m3e-space-3) 改成 auto */
		padding-top: var(--m3e-space-1) /* 👈 新增：用 padding-top 来保持上方的间距 */
		font-size: 0.8rem
		color: var(--on-surface-variant)

		/* 每一项（日期/字数/时间） */
		&-item
			display: inline-flex
			align-items: center
			gap: 0.25rem
			> :global(svg)
				width: 1.1em
				height: 1.1em
				color: var(--on-surface-variant)
				transform: translateY(0) !important  /* 👈 核心：强行重置上方带来的位移，让图标和文字平齐 */
				vertical-align: middle

		/* 竖线分隔符 */
		&-divider
			color: var(--outline-variant)
			opacity: 0.6
			margin: 0 0.1rem
			font-weight: 300
	/* 👆👆👆 结束 👆👆👆 */

	&__cover
		position: relative
		flex-shrink: 0
		display: block
		overflow: hidden
		text-decoration: none

		/* 👇 新增：占位块的样式 */
		&-placeholder
			width: 100%
			height: 100%
			background: var(--card-bg)
			/* 如果你想要纯色，就保持这样；如果想要一个淡淡的图标，可以加下面这两行 */
			display: flex
			align-items: center
			justify-content: center
			color: var(--on-surface-variant)
			opacity: 0.5
		
		> :global(.m3-blog-postcard__cover-loading)
			position: absolute
			inset: 0
			display: flex
			align-items: center
			justify-content: center
			background: var(--surface-container-low)
			transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard)
		> :global(.m3-blog-postcard__cover-loading)::after
			content: ""
			width: 2rem
			aspect-ratio: 1
			border-radius: var(--shape-corner-full)
			background: var(--primary-container)
		> :global(.m3-blog-postcard__cover-loading--done)
			opacity: 0
			pointer-events: none
		> picture,
		> picture > img
			display: block
			width: 100%
			height: 100%
		
		/* 👇 图片放大动画 */
		> picture > img
			object-fit: cover
			position: relative
			transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1)
			
		.m3-blog-postcard:hover & > picture > img
			transform: scale(1.05)

		@media (min-width: bp-md)
			position: absolute
			top: 0
			right: 0
			bottom: 0
			width: 32%
			height: 100%
			border-radius: 0
			overflow: hidden
			
			/* 👇 默认状态：渐变范围大（虚化明显），并加上过渡动画 */
			mask-image: linear-gradient(to right, transparent 0%, black 30%)
			-webkit-mask-image: linear-gradient(to right, transparent 0%, black 30%)
			transition: mask-image 0.4s cubic-bezier(0.2, 0, 0, 1), -webkit-mask-image 0.4s cubic-bezier(0.2, 0, 0, 1)
			
			/* 👇 悬停状态：渐变范围缩小（分界线变清晰） */
			.m3-blog-postcard:hover &
				mask-image: linear-gradient(to right, transparent 0%, black 5%)
				-webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%)

	/* 桌面端（≥md）正文变纵向：给右侧让位（断点用 stylus 编译期常量 bp-md，
	   不能写 @media (--m3e-bp-md)：CSS 变量无法作 media 条件，该写法整块失效） */
	@media (min-width: bp-md)
		flex-direction: column
		&--cover &__body
			padding-right: calc(32% + 1rem)
		/* 👇 改成和上面一致，让无图文章右侧也留出大片空白 */
		&:not(.m3-blog-postcard--cover) &__body
			padding-right: calc(32% + 1rem)

		/* 👇 新增：列表模式下，无图卡片隐藏封面容器 */
		&:not(.m3-blog-postcard--cover) &__cover
			display: none

	/* === 移动端：封面置顶布局优化（桌面端保持不动） === */
	@media (max-width: bp-md - 1px)
		/* 原始设计：标题竖线仅桌面显示 */
		.m3-blog-postcard__title :global(.m3-accent-bar)
			display: none

		/* 👇 在这里新增：移动端隐藏无图的占位块 👇 */
		&:not(.m3-blog-postcard--cover) &__cover
			display: none
		/* 👆 新增结束 👆 */

		/* 封面内缩置顶：四周留 1rem、2:1 宽比、0.75rem 圆角 */
		&__cover
			width: auto
			aspect-ratio: 2 / 1
			margin: 1rem 1rem 0
			border-radius: var(--shape-corner-m)
			> picture,
			> picture > img
				width: 100%
				height: 100%

		/* 正文统一 1rem 内边距 */
		&__body
			padding: 1rem

		/* 原始设计：标题尾部箭头 2rem */
		&__arrow
			width: 2rem
			height: 2rem

/* ============================================================
   容器模式联动（PostPage 的命名容器 + #post-list 类钩子）
   同一卡片按所在容器切换 token 形态，而非两套皮肤：
   - m3e-post-list--grid     封面 16:9 通栏贴边（复用移动端封面置顶语言）
   - m3e-post-list--cover-left  list 模式封面居左（桌面 ≥md 镜像布局）
   注意：钩子选择器用单个 &（自身复合），禁止 `& &`（会编译成嵌套后代，
   修饰符形式永不匹配）。
   ============================================================ */
.m3-blog-postcard
	/* —— 网格（瀑布流）模式：仅在容器确实能形成至少两列时生效 ——
	   封面内缩（与正文左右边缘对齐 --m3e-space-4，圆角 m、2:1）；
	   无封面卡片沿用 list 的右上 enter 箭头区块（正文右缘自动让位）；
	   卡片高度天然混合（有/无封面），由 PostPage 的 JS 最短列打包消除空洞 */
	grid-card-layout(shell-selector)
		:global({shell-selector} .m3e-post-list--grid) &
			flex-direction: column-reverse
			height: 365px
			overflow: hidden

		/* 👇 新增：网格模式下隐藏标题的小竖线 */
		:global({shell-selector} .m3e-post-list--grid) &__title :global(.m3-accent-bar)
			display: none

		/* 👇 新增：网格模式下，强制无图卡片显示封面容器，撑开等高卡片 */
		:global({shell-selector} .m3e-post-list--grid) &:not(.m3-blog-postcard--cover) &__cover
			display: block

		/* 封面和正文使用同一套内缩节奏，避免出现错位的内容边缘 */
		:global({shell-selector} .m3e-post-list--grid) &__cover
			position: relative
			inset: auto
			width: auto
			height: auto
			aspect-ratio: 16 / 9
			margin: 0
			border-radius: 0
			/* 👇 新增：网格模式下强制取消虚化遮罩 */
			mask-image: none
			-webkit-mask-image: none

		/* 👇 新增：网格模式下鼠标悬停时也强制取消虚化 */
		:global({shell-selector} .m3e-post-list--grid) .m3-blog-postcard:hover &__cover
			mask-image: none !important
			-webkit-mask-image: none !important

		/* 显式加入卡片根类，提高优先级并覆写 list 的封面让位内边距。 */
		:global({shell-selector} .m3e-post-list--grid .m3-blog-postcard) &__body
			padding: var(--m3e-space-4)

		/* 右侧 enter 大箭头区块已在，隐藏冗余的标题内联箭头。 */
		:global({shell-selector} .m3e-post-list--grid) &__arrow
			display: none

	@media (min-width: bp-md)
		@container post-list-layout (min-width: 41rem)
			grid-card-layout('.m3e-post-list-shell--compact')

		@container post-list-layout (min-width: 49rem)
			grid-card-layout('.m3e-post-list-shell--regular')

		@container post-list-layout (min-width: 57rem)
			grid-card-layout('.m3e-post-list-shell--relaxed')

	/* —— 列表封面居左：仅桌面 ≥md，镜像右侧布局 —— */
	@media (min-width: bp-md)
		:global(.m3e-post-list--cover-left) &__cover
			right: auto
			left: 0.75rem

		:global(.m3e-post-list--cover-left) &--cover &__body
			padding-right: 1.5rem
			padding-left: calc(28% + 1.5rem)
</style>
