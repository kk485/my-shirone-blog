---
/**
 * M3E 博客原子 — PostMeta 文章元信息行。
 * 数据驱动：日期 / 更新日期 / 分类 / 字数 / 标签均为展示层 props（由调用方格式化）。
 * 每个元信息项 = display/MetaIcon 图标徽标（32px tonal 圆角方块）+
 * body-medium 文字；链接 hover 变 primary。
 */
import MetaIcon from "@components/atoms/display/MetaIcon.astro";

export interface BlogMetaLink {
	name: string;
	href: string;
}

interface Props {
	class?: string;
	/** 发布日期（展示文本，如 "2026-08-13"） */
	published?: string;
	/** 更新日期（与 published 不同才渲染） */
	updated?: string;
	category?: BlogMetaLink | null;
	tags?: BlogMetaLink[];
	/** 字数展示文本（如 "1426 words"，渲染在分类右侧） */
	wordCount?: string;
	/** 隐藏标签段 */
	hideTags?: boolean;
	/** 隐藏更新日期 */
	hideUpdate?: boolean;
	hideDate?: boolean;
	hideCategory?: boolean;
	hideWordCount?: boolean;
	/** 无分类时的占位文案 */
	uncategorizedLabel?: string;
	/** 无标签时的占位文案 */
	noTagsLabel?: string;
}

const {
	class: className,
	published,
	updated,
	category,
	tags = [],
	wordCount,
	hideTags = false,
	hideUpdate = false,
	hideDate = false,
	hideCategory = false,
	hideWordCount = false,
	uncategorizedLabel = "未分类",
	noTagsLabel = "无标签",
} = Astro.props;
---

<div class:list={["m3-blog-postmeta", className]}>
	{!hideDate && published && (
		<span class="m3-blog-postmeta__item">
			<MetaIcon icon="material-symbols:calendar-today-outline-rounded" />
			<span class="m3-blog-postmeta__text">{published}</span>
		</span>
	)}

	{!hideUpdate && updated && updated !== published && (
		<span class="m3-blog-postmeta__item">
			<MetaIcon icon="material-symbols:edit-calendar-outline-rounded" />
			<span class="m3-blog-postmeta__text">{updated}</span>
		</span>
	)}

	{!hideWordCount && wordCount && (
		<span class="m3-blog-postmeta__item">
			<MetaIcon icon="material-symbols:article-outline-rounded" />
			<span class="m3-blog-postmeta__text">{wordCount}</span>
		</span>
	)}

	{(!hideCategory || (!hideTags && tags.length > 0)) && (
		<span class="m3-blog-postmeta__item m3-blog-postmeta__item--taxonomy">
			{!hideCategory && (
				<>
					<MetaIcon icon="material-symbols:book-2-outline-rounded" />
					{category ? (
						<a
							class="m3-blog-postmeta__link m3-blog-postmeta__category"
							href={category.href}
							aria-label={`View all posts in the ${category.name} category`}
						>{category.name}</a>
					) : (
						<span class="m3-blog-postmeta__text m3-blog-postmeta__category">{uncategorizedLabel}</span>
					)}
				</>
			)}
			{!hideTags && tags.length > 0 && (
				<>
					<MetaIcon icon="material-symbols:tag-rounded" />
					<span class="m3-blog-postmeta__tags">
						{tags.map((t, i) => (
							<Fragment>
								<a
									class:list={["m3-blog-postmeta__link", { "m3-blog-postmeta__link--with-sep": i > 0 }]}
									href={t.href}
									aria-label={`View all posts with the ${t.name} tag`}
								>{t.name}</a>
							</Fragment>
						))}
					</span>
				</>
			)}
		</span>
	)}
</div>

<style lang="stylus">
.m3-blog-postmeta
	display: flex
	flex-wrap: wrap
	align-items: center
	gap: 0.5rem 0.75rem
	color: var(--on-surface-variant)
	line-height: 1.6

	&__item
		display: inline-flex
		align-items: center
		gap: 0.25rem
		min-width: 0

	/* 分类+标签合并段：纯文本流排版 */
	&__item--taxonomy
		display: inline
		line-height: 1.6

	/* 分类文字右侧留白，推开后面的标签 */
	&__category
		padding-right: 0.5rem

	/* 标签容器 */
	&__tags
		display: inline

	&__text
		font-size: 0.75rem
		font-weight: 500

	&__link
		font-size: 0.75rem
		font-weight: 500
		text-decoration: none
		color: var(--on-surface-variant)
		&:hover
			color: var(--primary)

	/* 👇 完美对称的斜杠伪元素 */
	&__link--with-sep
		&::before
			content: "/"
			display: inline-block
			margin: 0 0.4rem
			color: var(--outline-variant)
			font-size: 0.875rem	

/* 终极图标对齐 */
:global(.m3-blog-postmeta) :global(.m3-meta-icon)
	display: inline-flex
	align-items: center
	justify-content: center
	width: 0.95em
	height: 0.95em
	border-radius: 0
	background: transparent
	color: inherit
	line-height: 1
	vertical-align: middle
	transform: translateY(-1px)
	margin-right: 0.2rem
	> :global(svg)
		width: 100%
		height: 100%
</style>
